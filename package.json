{
  "name": "vs_gesture",
  "description": "Gesture.js uniformizes pointer and gesture inputs across mobile and desktop browsers.",
  "repository": "git@github.com:dthevenin/Gesture.git",
  "author": "<david.thevenin@gmail.com>",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist build",
    "prepublish": "npm run clean && npm run build",
    "tsc": "tsc -p src/tsconfig.json",
    "make-bundle": "rollup --config",
    "build": "npm run clean; npm run tsc; npm run make-bundle",
    "test": "nyc mocha test/*.js test/**/*.js  test/**/**/*.js"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vs_ui_utils": "../VS_ui_utils",
    "vs_utils": "../VS_utils"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "types": "./dist/vs_gesture.d.js",
  "exports": {
    ".": {
      "import": "./dist/vs_gesture.es.js",
      "require": "./dist/vs_gesture.amd.js",
      "types": "./dist/vs_gesture.d.js"
    }
  }
}
